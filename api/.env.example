APP_NAME="Service Scheduler"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# JSON logs on stderr (docker compose logs php). Never log passwords, tokens, phones or emails.
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docker-compose.yml overrides DB_HOST and DB_PORT for the containers.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=scheduler
DB_USERNAME=scheduler
DB_PASSWORD=scheduler

# Shared by every PHP-FPM worker.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum SPA mode: nginx (8088) and the Vite dev server (5173).
SANCTUM_STATEFUL_DOMAINS=localhost:8088,localhost:5173,127.0.0.1:8088

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Business settings
HOLD_MINUTES=5
IDEMPOTENCY_TTL_HOURS=24

# OpenTelemetry tracing (off by default)
OTEL_SDK_DISABLED=true

# Seed staff accounts (local only; never commit real passwords).
SEED_ADMIN_PASSWORD=
SEED_ADVISOR_PASSWORD=
SEED_FOREMAN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
