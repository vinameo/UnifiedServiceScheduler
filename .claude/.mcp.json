{
  "mcpServers": {
    "postgres-mcp": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["dlx", "@microsoft/postgres-mcp@0.2.0", "run", "--no-telemetry"],
      "env": {
        "POSTGRES_MCP_QUERY_TIMEOUT_MS": "540000"
      },
      "timeout": 90000
    },
    "plane-selfhost-postgres": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "@modelcontextprotocol/server-postgres",
        "postgresql://plane:plane@localhost:5434/plane"
      ]
    },
    "open-plany-postgres": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "@modelcontextprotocol/server-postgres",
        "postgresql://openplany:openplany@localhost:5432/openplany"
      ]
    }
  }
}