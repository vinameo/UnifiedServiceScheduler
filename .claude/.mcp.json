{
  "mcpServers": {
    "postgres-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@microsoft/postgres-mcp@0.2.0", "run", "--no-telemetry"],
      "env": {
        "POSTGRES_MCP_QUERY_TIMEOUT_MS": "540000"
      },
      "timeout": 90000
    },
    "scheduler-postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://scheduler:scheduler@localhost:5432/scheduler"
      ]
    }
  }
}
