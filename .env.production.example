# Copy to .env.production (never commit it) and fill in every value marked CHANGE_ME.
# Used by docker-compose.prod.yml for both compose interpolation and the php containers.

APP_NAME="Service Scheduler"
APP_ENV=production
APP_DEBUG=false
# Generate with: docker run --rm service-scheduler-php:latest php artisan key:generate --show
APP_KEY=CHANGE_ME
APP_URL=https://scheduler.example.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_DATABASE=scheduler
DB_USERNAME=scheduler
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=scheduler.example.com
SANCTUM_STATEFUL_DOMAINS=scheduler.example.com

CACHE_STORE=database
QUEUE_CONNECTION=database

HOLD_MINUTES=5
IDEMPOTENCY_TTL_HOURS=24

# Seed staff accounts. Set RUN_SEEDERS=true for the first deploy.
RUN_SEEDERS=false
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADVISOR_PASSWORD=CHANGE_ME
SEED_FOREMAN_PASSWORD=CHANGE_ME

# Ports and certificates on the host
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./docker/nginx/certs
